{
  "name": "blood-organ-network-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Blood & Organ Availability Network (DBMS course project)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/setup-database.js",
    "db:reset": "node scripts/setup-database.js",
    "test": "node --test tests/*.test.js",
    "lint": "node --check src/server.js",
    "pretest": "node scripts/setup-database.js --quiet",
    "db:structure": "node scripts/setup-database.js --no-seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}

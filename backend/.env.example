# ---------------------------------------------------------------------------
# Copy to .env and adjust.  NEVER commit the real .env file.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=blood_organ_network
DB_CONNECTION_LIMIT=10

# Authentication -- generate with:  openssl rand -hex 48
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Frontend origin(s) allowed by CORS -- comma-separated for several.
# In development any localhost port is accepted automatically, because Vite
# picks the next free port when 5173 is already in use.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
